{
  "strictPluginOnlyCustomization": ["skills", "agents", "hooks", "mcp"],
  "allowManagedHooksOnly": true,
  "disableSideloadFlags": true,

  "strictKnownMarketplaces": [
    {
      "source": "git",
      "url": "https://gitlab.example.com/ai-engineering/ai-engineering-os.git"
    }
  ],
  "extraKnownMarketplaces": {
    "ai-engineering": {
      "source": {
        "source": "git",
        "url": "https://gitlab.example.com/ai-engineering/ai-engineering-os.git",
        "ref": "ai-engineering-os--v0.17.0"
      }
    }
  },
  "enabledPlugins": {
    "ai-engineering-os@ai-engineering": true
  },
  "pluginTrustMessage": "Plugins from the ai-engineering marketplace are reviewed and approved by the AI Engineering Platform Team.",

  "permissions": {
    "deny": [
      "Read(//**/.ssh/**)",
      "Read(//**/*.pem)",
      "Read(//**/*.p12)",
      "Read(//**/id_rsa*)",
      "Read(//**/id_ed25519*)",
      "Read(//**/.aws/credentials)",
      "Read(//**/.gnupg/**)",
      "Read(//**/.netrc)",
      "Read(//**/.docker/config.json)",
      "Edit(//**/.ssh/**)",
      "Edit(//**/*.pem)",
      "Edit(//**/.aws/credentials)"
    ],
    "disableBypassPermissionsMode": "disable"
  },

  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0"
  }
}
