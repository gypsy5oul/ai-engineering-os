  "categories": {
    "lifecycle": "A change moved between macro stages.",
    "task": "Work-item level activity inside a department cycle.",
    "review": "A verdict, or a request for changes.",
    "quality": "Testing, defects, pipeline results.",
    "security": "Findings, blocks, exceptions, advisories.",
    "release": "Assembling and approving a release.",
    "deployment": "Authorizing, executing and verifying a deployment.",
    "incident": "Production response and its aftermath.",
    "governance": "Decisions, escalations, guard actions.",
    "communication": "The notification subsystem's own events."
  },
  "standard_fields": {
    "required": [
      "id",
      "type",
      "at",
      "project",
      "source",
      "level",
      "subject",
      "category",
      "actor_type",
      "correlation_id"
    ],
    "recommended": [
      "actor",
      "severity",
      "status",
      "artifact",
      "stage",
      "cycle",
      "payload"
    ],
    "correlation_id": "Ties every event about one change together across workflows. Usually the feature id; the incident id during an incident. Without it, a feature thread and an audit trail cannot be reconstructed from the log."
  }
}
