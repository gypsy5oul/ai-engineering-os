{
  "version": "1",
  "description": "The events the SDLC emits. The notification subsystem consumes these and never polls. An event is a fact about the past, named in the past tense, carrying facts only - no prose, no recipient list, no formatting. Routing is the policy engine's job; wording is the notification agent's.",
  "level_meaning": {
    "worker": "One person's or one agent's activity on one item. Recorded, almost never notified.",
    "team": "Something the working team needs to act on.",
    "department": "A rollup: the aggregate state of a department, not individual activity.",
    "organization": "A lifecycle milestone the wider engineering group should know about.",
    "incident": "Immediate. Someone is expected to respond now."
  },
  "design_rules": [
    "Events carry facts. If a field would need a sentence written by a model, it does not belong in the event.",
    "The notification subsystem is never the event source. It cannot ask 'did anything happen'.",
    "Department-level events are rollups, so ten workers on one feature produce one message rather than thirty.",
    "An event never carries a recipient list. Recipients come from the policy at routing time."
  ],
  "events": [
