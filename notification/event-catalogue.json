    "recommended": [
      "actor",
      "severity",
      "status",
      "artifact",
      "stage",
      "cycle",
      "payload"
    ],
    "correlation_id": "Ties every event about one change together across workflows. Usually the feature id; the incident id during an incident. Without it, a feature thread and an audit trail cannot be reconstructed from the log."
  }
