{
  "description": "AI Engineering OS safety and governance hooks. Failure is risk-tiered, not blanket fail-open: a catastrophic or high-risk action is denied when a guard cannot complete, a sensitive one is escalated to a human, and only advisory guards fail open. See hooks/lib/failsafe.py and docs/hooks.md. Every decision is written to the audit log.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard_bash.py\"",
            "timeout": 15,
            "statusMessage": "Checking command against organization policy"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard_write.py\"",
            "timeout": 15,
            "statusMessage": "Checking write scope and secret exposure"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard_spawn.py\"",
            "timeout": 10,
            "statusMessage": "Checking spawn authority"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/audit_log.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/inject_context.py\"",
            "timeout": 10,
            "statusMessage": "Giving the agent its work item"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check_artifacts.py\"",
            "timeout": 15,
            "statusMessage": "Checking the artifacts this session wrote"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/observe_subagent.py\"",
            "timeout": 10,
            "statusMessage": "Recording the result against its task"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check_artifacts.py\"",
            "timeout": 15,
            "statusMessage": "Checking the artifacts this session wrote"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/gate_task_completion.py\"",
            "timeout": 20,
            "statusMessage": "Checking the definition of done before this closes"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session_context.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/teammate_idle.py\"",
            "timeout": 10,
            "statusMessage": "Checking the teammate still owes nothing"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/record_worktree.py\"",
            "timeout": 10,
            "statusMessage": "Recording the worktree"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/record_worktree.py\"",
            "timeout": 10,
            "statusMessage": "Recording the worktree"
          }
        ]
      }
    ]
  }
}
