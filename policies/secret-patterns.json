{
  "version": "1",
  "description": "Patterns used by hooks/scripts/guard_write.py (before a file is written) and scripts/secret_scan.py (over the repository). Detection is heuristic: it is a safety net, not a replacement for a dedicated scanner in CI.",
  "patterns": [
    {
      "id": "SP-01",
      "name": "AWS access key id",
      "pattern": "\\b(A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA)[A-Z0-9]{16}\\b",
      "severity": "critical"
    },
    {
      "id": "SP-02",
      "name": "Private key block",
      "pattern": "-----BEGIN (RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY( BLOCK)?-----",
      "severity": "critical"
    },
    {
      "id": "SP-03",
      "name": "GitLab personal access token",
      "pattern": "\\bglpat-[A-Za-z0-9_\\-]{20,}",
      "severity": "critical"
    },
    {
      "id": "SP-04",
      "name": "GitHub token",
      "pattern": "\\bgh[pousr]_[A-Za-z0-9]{36,}",
      "severity": "critical"
    },
    {
      "id": "SP-05",
      "name": "Slack token",
      "pattern": "\\bxox[abprs]-[A-Za-z0-9-]{10,}",
      "severity": "critical"
    },
    {
      "id": "SP-06",
      "name": "Google API key",
      "pattern": "\\bAIza[0-9A-Za-z_\\-]{35}\\b",
      "severity": "critical"
    },
    {
      "id": "SP-07",
      "name": "Anthropic API key",
      "pattern": "\\bsk-ant-[A-Za-z0-9_\\-]{20,}",
      "severity": "critical"
    },
    {
      "id": "SP-08",
      "name": "Generic assigned secret",
      "pattern": "(?i)\\b(password|passwd|secret|api[_-]?key|access[_-]?token|client[_-]?secret|private[_-]?key)\\b\\s*[:=]\\s*[\"']([^\"'\\s${}<>]{12,})[\"']",
      "severity": "major",
      "allow_if_matches": [
        "(?i)^(changeme|placeholder|example|redacted|dummy|test|xxx+|\\*+|your[-_].*|<.*>|\\$\\{.*\\})$"
      ]
    },
    {
      "id": "SP-09",
      "name": "JWT",
      "pattern": "\\beyJ[A-Za-z0-9_\\-]{10,}\\.[A-Za-z0-9_\\-]{10,}\\.[A-Za-z0-9_\\-]{10,}",
      "severity": "major"
    },
    {
      "id": "SP-10",
      "name": "Connection string with inline credentials",
      "pattern": "\\b[a-z][a-z0-9+.\\-]*://[^\\s:/@]+:[^\\s:/@]{6,}@[^\\s/]+",
      "severity": "critical",
      "allow_if_matches": [
        "(?i):(password|changeme|example|user|pass|token|secret)@",
        ":(\\$\\{[^}]+\\}|<[^>]+>|[A-Z][A-Z0-9_]{3,})@"
      ]
    }
  ],
  "path_denylist": [
    "**/.env",
    "**/.env.*",
    "**/*.pem",
    "**/*.key",
    "**/*.p12",
    "**/*.pfx",
    "**/id_rsa*",
    "**/id_ed25519*",
    "**/.ssh/**",
    "**/.aws/credentials",
    "**/.kube/config",
    "**/*.kdbx",
    "**/credentials.json",
    "**/service-account*.json"
  ],
  "scan_excludes": [
    "**/.git/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/*.min.js",
    "**/__pycache__/**",
    "**/reports/**"
  ],
  "self_exclusions": [
    "policies/secret-patterns.json",
    "tests/**",
    "docs/security.md",
    "evaluations/**"
  ]
}