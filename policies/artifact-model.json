{
  "version": "2",
  "description": "Formal artifact contracts. Every type declares who creates it, who may modify it, who may review it, who may approve it, where it is stored, what it depends on and what consumes it. This is the state model of the organization; the workflows only move between states.",
  "required_fields": {
    "id": "PROJECT-KEY-CODE-NNN, sequential per type, never reused, never renumbered",
    "type": "one of the artifact types below",
    "title": "human-readable",
    "status": "from the type's status list",
    "owner": "role that owns the artifact",
    "version": "integer, incremented on every material change",
    "created_at": "YYYY-MM-DD",
    "updated_at": "YYYY-MM-DD",
    "source": "where this came from: a requester, an artifact id, an incident, an advisory",
    "reviewers": "agent verdicts: who reviewed, what verdict, when",
    "approvals": "human approvals: who, what policy reference, where it is recorded",
    "dependencies": "artifact ids this one cannot be completed without",
    "links": "traceability edges, per schemas/artifact-header.schema.json"
  },
  "invariants": [
    "reviewers and approvals are separate fields and never merge. An agent verdict is not an approval.",
    "An artifact with no source was invented. That is a finding, not a style issue.",
    "version increments on material change; updated_at moves with it.",
    "A superseded artifact is never edited. A new one supersedes it.",
    "An artifact whose dependencies are unmet cannot reach 'approved'."
  ],
  "artifact_types": [
