  "dod_predicates": {
    "artifact_exists": {
      "args": [
        "artifact_code"
      ],
      "checkable": "project",
      "means": "An artifact of this type exists for the change."
    },
    "artifact_status": {
      "args": [
        "artifact_code",
        "status"
      ],
      "checkable": "project",
      "means": "The named artifact has reached this status."
    },
    "every_linked": {
      "args": [
        "from_code",
        "to_code"
      ],
      "checkable": "project",
      "means": "Every artifact of from_code links to at least one of to_code. This is how coverage gaps become visible."
    },
    "field_quantified": {
      "args": [
        "artifact_code",
        "field"
      ],
      "checkable": "project",
      "means": "The field holds a number or an explicit blocking open question, never a plausible default."
    },
    "agent_verdict": {
      "args": [
        "reviewer",
        "verdict"
      ],
      "checkable": "project",
      "means": "The named AI reviewer recorded this verdict. Never satisfies a human_gate."
    },
    "human_approval_recorded": {
      "args": [
        "policy_ref"
      ],
      "checkable": "gitlab",
      "means": "A named human recorded this approval outside the session."
    },
    "no_unresolved_findings": {
      "args": [
        "severity"
      ],
      "checkable": "project",
      "means": "No finding at or above this severity is open."
    },
    "pipeline_passed": {
      "args": [
        "pipeline"
      ],
      "checkable": "gitlab",
      "means": "The named CI pipeline passed on the merge commit."
    },
    "tests_pass": {
      "args": [
        "level"
      ],
      "checkable": "project",
      "means": "The named test level passed."
    },
    "reproduction_fails_before_fix": {
      "args": [],
      "checkable": "project",
      "means": "The regression test was verified to fail against the unfixed code. Writing it first is the point."
    },
    "rollback_plan_or_acknowledged": {
      "args": [],
      "checkable": "project",
      "means": "A rollback plan exists, or irreversibility is acknowledged in writing by a human."
    },
    "config_valid": {
      "args": [],
      "checkable": "repo",
      "means": "The project configuration validates against schemas/project-config.schema.json."
    },
    "no_blocking_open_decisions": {
      "args": [
        "area"
      ],
      "checkable": "project",
      "means": "No open_decision with blocking true remains for this area."
    },
    "decision_resolved": {
      "args": [
        "decision_id"
      ],
      "checkable": "project",
      "means": "The named open decision is answered. An agent blocked by one names it by id and stops."
    },
    "no_open_blocking_decisions_for": {
      "args": [
        "artifact_code"
      ],
      "checkable": "project",
      "means": "No open DEC blocks the production of this artifact type."
    },
    "evidence_sealed": {
      "args": [],
      "checkable": "project",
      "means": "An EVID record exists and is sealed, collected before any destructive remediation."
    },
    "artifact_owned_by": {
      "args": [
        "artifact_code",
        "role"
      ],
      "checkable": "project",
      "means": "The artifact's owner field matches the role the contract assigns."
    },
    "required_fields_present": {
      "args": [
        "artifact_code"
      ],
      "checkable": "project",
      "means": "Every field the artifact contract requires is present and non-empty."
    },
    "human_identity_recorded": {
      "args": [
        "policy_ref"
      ],
      "checkable": "project",
      "means": "The approval carries an approver_id and an approver_role that is not an agent."
    },
    "release_authorized": {
      "args": [],
      "checkable": "project",
      "means": "The release reached the 'authorized' state: content approval and deployment authorization are separate acts."
    },
    "cycle_accepted": {
      "args": [
        "cycle_id"
      ],
      "checkable": "project",
      "means": "The department's internal execution cycle reached ACCEPTED: every work item passed self validation, peer review and lead review, and no rework or escalation is open."
    },
    "cycle_rollup_reported": {
      "args": [
        "cycle_id"
      ],
      "checkable": "project",
      "means": "The lead produced the rollup for the head. A department that completed without reporting has not finished; the head cannot see whether the department is healthy."
    },
    "no_open_rework": {
      "args": [
        "cycle_id"
      ],
      "checkable": "project",
      "means": "No work item sits in CHANGES_REQUESTED or has exceeded the rework limit."
    },
    "corrective_actions_tracked": {
      "args": [
        "artifact_code"
      ],
      "checkable": "project",
      "means": "Every artifact of this type links to at least one tracked corrective action: a defect, a debt item, a requirement or an architecture decision. every_linked(RCA, DEF) demanded a defect specifically, so an incident whose corrective actions were all monitoring or process improvements -- outcomes the stage itself lists as valid -- could only satisfy its own definition of done by inventing a defect."
    },
    "every_skip_recorded": {
      "args": [],
      "checkable": "project",
      "means": "Every stage this change skips carries a written reason. The predicate used to name one stage, skip_recorded(UX), which demanded a skip reason for UX even when UX ran."
    }
  },
  "checkability": {
    "repo": "Evaluated by this plugin's own validators.",
    "project": "Evaluated against the project's artifacts by scripts/check_dod.py when run inside a project.",
    "gitlab": "Evaluated against GitLab. Not evaluable from a session alone; the predicate records the requirement and names where the evidence lives."
  },
  "contract_fields": {
    "owner_role": "The role that creates it. Exactly one.",
    "may_modify": "Roles permitted to change it after creation. Empty means immutable to agents.",
    "may_review": "Roles that may record an AGENT verdict on it.",
    "may_approve": "The HUMAN role that may approve it, or kind 'none'. Never an agent.",
    "storage": "Where it lives. Aligned with policies/write-scope.json.",
    "required_fields": "Base contract plus type-specific fields.",
    "depends_on": "Upstream artifact codes that must exist first.",
    "consumed_by": "Downstream artifact codes that reference it.",
    "immutable_after_creation": "True for evidence: appended to, never rewritten.",
    "append_only": "True where the artifact grows but is never rewritten: the incident record gains timeline entries during the incident and is never edited afterwards."
  }
}
