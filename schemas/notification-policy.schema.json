{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Notification policy",
  "description": "Deterministic routing. Answers should anyone be notified, who, and on which channel. An LLM never makes these decisions; it only turns the resulting decision into a human-readable message.",
  "type": "object",
  "required": ["version", "principles", "levels", "rules", "defaults"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string" },
    "description": { "type": "string" },
    "principles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "levels": {
      "type": "object",
      "patternProperties": {
        "^(worker|team|department|organization|incident)$": {
          "type": "object", "required": ["notify", "rationale"], "additionalProperties": false,
          "properties": {
            "notify": { "type": "string", "enum": ["never", "aggregate", "immediate"] },
            "rationale": { "type": "string" },
            "audience": { "type": "string" }
          }
        }
      }
    },
    "defaults": {
      "type": "object", "required": ["channel", "thread_strategy", "aggregate_window_minutes"],
      "additionalProperties": false,
      "properties": {
        "channel": { "type": "string" },
        "thread_strategy": { "type": "string", "enum": ["subject", "correlation", "none", "daily"] },
        "aggregate_window_minutes": { "type": "integer", "minimum": 0 }
      }
    },
    "rules": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["event", "notify", "channel", "priority"],
        "additionalProperties": false,
        "properties": {
          "event": { "type": "string" },
          "notify": { "type": "string", "enum": ["never", "aggregate", "immediate"] },
          "channel": { "type": "string" },
          "also_channels": { "type": "array", "items": { "type": "string" } },
          "recipients": { "type": "array", "items": { "type": "string" },
            "description": "Roles, never individuals. A person is resolved from the project's approval section at send time." },
          "priority": { "type": "string", "enum": ["low", "normal", "high", "urgent"] },
          "thread": { "type": "string", "enum": ["subject", "correlation", "none", "daily"] },
          "template": { "type": "string" },
          "when": { "type": "object", "additionalProperties": true,
            "description": "Optional payload conditions, e.g. severity in [critical, high]." },
          "suppress_if": { "type": "string" }
        }
      }
    },
    "suppression": {
      "type": "object", "additionalProperties": true
    },
    "digests": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "schedule", "channel", "template"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "schedule": { "type": "string" },
          "channel": { "type": "string" },
          "template": { "type": "string" },
          "sections": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
