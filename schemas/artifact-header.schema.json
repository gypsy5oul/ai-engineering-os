{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project artifact header",
  "description": "YAML front matter carried by every project artifact. The contract for each type - owner, lifecycle, required links, review and approval path - is in policies/artifact-model.json. reviewers (agent verdicts) and approvals (human decisions) are separate fields and never merge.",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "status",
    "owner",
    "version",
    "created_at",
    "updated_at",
    "source",
    "links"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{1,9}-(ADR|ARCH|DEBT|DEC|DEF|DEPA|DES|EPIC|EVID|FEAS|INC|MR|NFR|RCA|REL|REQ|REVIEW|SEC|STORY|TASK|TEST|TESTREPORT|TP)-[0-9]{3,}$"
    },
    "type": {
      "type": "string",
      "enum": [
        "adr",
        "architecture",
        "defect",
        "dependency-assessment",
        "design",
        "epic",
        "evidence",
        "feasibility",
        "incident",
        "nfr",
        "open-decision",
        "rca",
        "release",
        "requirement",
        "review",
        "security",
        "story",
        "task",
        "technical-debt",
        "test-case",
        "test-plan",
        "test-report"
      ]
    },
    "change": {
      "type": "string",
      "description": "The unit of work this artifact belongs to: one feature, defect, incident or release. Without it, definition-of-done predicates match every artifact in the project, so a finished run vacuously satisfies a new one and two concurrent runs starve each other. Use the id of the artifact that opened the work (an EPIC, DEF, INC or REL).",
      "pattern": "^[A-Z][A-Z0-9]{1,9}-(EPIC|DEF|INC|REL|REQ)-[0-9]{3,}$"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "status": {
      "type": "string",
      "enum": [
        "accepted",
        "answered",
        "approved",
        "authorized",
        "closed",
        "collected",
        "done",
        "draft",
        "in-review",
        "mitigated",
        "open",
        "proposed",
        "recovered",
        "rejected",
        "rolled-back",
        "sealed",
        "superseded",
        "withdrawn"
      ]
    },
    "owner": {
      "type": "string"
    },
    "supersedes": {
      "type": "string"
    },
    "links": {
      "type": "object",
      "description": "Traceability edges. Every artifact states what it came from and what it produces.",
      "additionalProperties": false,
      "properties": {
        "requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "architecture": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "adrs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "defects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "merge_requests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "releases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "incidents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rcas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Incremented on every material change."
    },
    "created_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source": {
      "type": "string",
      "minLength": 3,
      "description": "Where this came from: a requester, an artifact id, an incident, an advisory. An artifact with no source was invented."
    },
    "reviewers": {
      "type": "array",
      "description": "AGENT verdicts. Never an approval on the organization's behalf. See policies/approval-authority.json.",
      "items": {
        "type": "object",
        "required": [
          "reviewer",
          "verdict",
          "at"
        ],
        "additionalProperties": false,
        "properties": {
          "reviewer": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "pass",
              "pass-with-conditions",
              "block",
              "not-applicable"
            ]
          },
          "at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "findings": {
            "type": "integer",
            "minimum": 0
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "approvals": {
      "type": "array",
      "description": "HUMAN decisions. Durable, recorded outside the session.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "approver_id",
          "approver_role",
          "at",
          "recorded_in",
          "decision"
        ],
        "additionalProperties": false,
        "description": "A HUMAN decision. approver_role must name a human role, never an agent. Validated by scripts/validate_plugin.py and by check_dod.py's human_identity_recorded predicate.",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AP-[0-9]{2}-[A-Za-z0-9_-]{3,}$",
            "description": "Unique instance id, e.g. AP-01-9283. Not the category id."
          },
          "policy_ref": {
            "type": "string",
            "pattern": "^AP-[0-9]{2}$"
          },
          "approver_id": {
            "type": "string",
            "minLength": 2,
            "description": "Stable identity of the person, e.g. a GitLab username."
          },
          "approver_role": {
            "type": "string",
            "minLength": 2,
            "description": "Human role held at the time, e.g. release-approver. Never an agent name."
          },
          "at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}(T[0-9:]{5,8}Z?)?$"
          },
          "recorded_in": {
            "type": "string",
            "minLength": 3
          },
          "decision": {
            "type": "string",
            "enum": [
              "approved",
              "rejected",
              "approved-with-conditions"
            ]
          },
          "conditions": {
            "type": "string"
          },
          "comment": {
            "type": "string"
          },
          "artifact": {
            "type": "string"
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Artifact ids this one cannot be completed without."
    },
    "superseded_by": {
      "type": "string"
    },
    "blocked_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Open decision ids (DEC-nnn) preventing this artifact from progressing."
    },
    "rollup": {
      "type": "object",
      "description": "Department cycle rollup, produced by the lead for the head. The head reads this and never the individual review rounds. See policies/department-cycle.json.",
      "required": [
        "cycle",
        "status",
        "produced_by",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "cycle": {
          "type": "string",
          "pattern": "^CYCLE-[A-Z0-9-]+$"
        },
        "status": {
          "type": "string",
          "enum": [
            "ACCEPTED",
            "ESCALATED",
            "IN_PROGRESS"
          ]
        },
        "produced_by": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}"
        },
        "streams": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "reviews": {
          "type": "object",
          "additionalProperties": true
        },
        "open_findings": {
          "type": "object",
          "additionalProperties": true
        },
        "rework_rounds": {
          "type": "integer",
          "minimum": 0
        },
        "escalations": {
          "type": "array",
          "description": "What left the department and to whom. An entry is OPEN until it carries resolved_at. Treating the list itself as 'open' made escalation self-punishing: a cycle that used the mechanism the design tells it to use could never close its macro stage again.",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "description": "An open escalation, stated in prose."
              },
              {
                "type": "object",
                "required": [
                  "to",
                  "reason"
                ],
                "additionalProperties": false,
                "properties": {
                  "to": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "raised_at": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}"
                  },
                  "resolved_at": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}",
                    "description": "Present once the escalation is answered. Its absence is what 'open' means."
                  },
                  "resolution": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_gate": {
          "type": "string"
        }
      }
    }
  }
}
