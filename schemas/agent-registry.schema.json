{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent registry",
  "type": "object",
  "required": [
    "version",
    "lifecycle_states",
    "agents"
  ],
  "additionalProperties": true,
  "properties": {
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "lifecycle_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "department",
          "purpose",
          "tool_profile",
          "default_model",
          "escalation_model",
          "risk",
          "owner",
          "version",
          "status",
          "review_frequency",
          "evaluation_suite",
          "may_spawn",
          "requires_human_approval_for"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "department": {
            "type": "string"
          },
          "purpose": {
            "type": "string",
            "minLength": 20
          },
          "tool_profile": {
            "type": "string",
            "enum": [
              "analysis-readonly",
              "review-readonly",
              "author",
              "delegating-author",
              "researching-author",
              "delegating-researcher",
              "implementer",
              "orchestrator",
              "lead",
              "reviewing-author",
              "analysing-author"
            ]
          },
          "default_model": {
            "type": "string",
            "enum": [
              "opus",
              "sonnet",
              "haiku",
              "fable",
              "inherit"
            ]
          },
          "escalation_model": {
            "type": "string",
            "enum": [
              "opus",
              "sonnet",
              "haiku",
              "fable",
              "inherit"
            ]
          },
          "risk": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 3
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "development",
              "evaluation",
              "security-review",
              "pilot",
              "approved",
              "production",
              "deprecated"
            ]
          },
          "review_frequency": {
            "type": "string",
            "enum": [
              "monthly",
              "quarterly",
              "biannual",
              "annual"
            ]
          },
          "evaluation_suite": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "may_spawn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requires_human_approval_for": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
